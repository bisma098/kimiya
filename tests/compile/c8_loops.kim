// Phase 2, Step 8: heat while and titrate

// heat while: repeat while the condition is true
20 -> temp;
heat while (temp < 100) {
    emit("temp:", temp);
    temp + 25 -> temp;
}
emit("final temp:", temp);

// titrate: count from a start number to an end number (both included)
titrate g from 1 to 5 {
    emit(g, "g ->", g * 2, "g");
}

// start and end can be expressions
3 -> n;
titrate i from n - 1 to n + 1 {
    emit("i =", i);
}

// changing the loop variable inside does not change the counting
titrate k from 1 to 3 {
    k * 100 -> k;
    emit("k changed to", k);
}

// loops inside loops, with observe inside
titrate a from 1 to 3 {
    titrate b from 1 to 3 {
        observe (a == b) {
            emit(a, "x", b, "=", a * b);
        }
    }
}

// a loop that never runs (start is bigger than end)
titrate z from 5 to 1 {
    emit("this never prints");
}

// a while loop that never runs
heat while (0) {
    emit("this never prints either");
}

// a loop variable keeps its last value after the loop
emit("g after the loop:", g);
emit("done");
// Phase 2, Step 4: arithmetic, negatives and comparisons

// arithmetic (same as tests/test2.kim)
emit(2 + 3 * 4);
emit((2 + 3) * 4);
emit(10 - 4 - 3);
emit(7 / 2);
emit(2.5 * 4);

// negatives
emit(-5);
emit(-2 * 3);
emit(10 - -4);

// comparisons: 1 = true, 0 = false
emit(16 > 10, 16 < 10, 16 == 16, 16 != 16, 16 >= 16, 16 <= 15);
emit(16 * 2 > 30);
emit(1 + 1 == 2);